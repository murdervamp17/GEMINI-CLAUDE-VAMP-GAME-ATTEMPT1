config_version=5

[application]
config/name="Vampire Telekinesis"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.055, 1)

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
grab={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
throw_object={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
release_object={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
